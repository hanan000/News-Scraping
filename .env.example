# Copy to .env and adjust as needed. Every value below is optional:
# the scraper falls back to these same defaults when a key is missing.

# User-Agent header sent with every request
SEARCH_USER_AGENT=Mozilla/5.0 (X11; Linux x86_64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/119.0.0.0 Safari/537.36

# HTML selectors per news source

# Webrazzi: class of the <div> holding the article body
WEBRAZZI=single-post-content

# DonanimHaber: JSON list of paragraph id prefixes (<article id>-<prefix>-<n>)
DONANIMHABER=["paragraph", "imgparagraph"]

# Wired: class of the <div> holding the article body
WIRED=body__inner-container

# The Verge: class of the <div> holding the article body
THE_VERGE=duet--article--article-body-component-container
